{
  "name": "nyamath",
  "private": true,
  "version": "0.0.0",
  "description": "Engineering worksheet for formulas, plots, and simulations",
  "author": "NyaMath contributors",
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "NyaMath",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:linux": "npm run build && electron-builder --linux",
    "electron:mac": "npm run build && electron-builder --mac",
    "electron:win": "npm run build && electron-builder --win",
    "electron:all": "npm run build && electron-builder --linux --mac --win",
    "seed": "node scripts/seed-db.mjs",
    "update-db": "node scripts/update-db.mjs",
    "codata": "node scripts/fetch-codata.mjs",
    "elements": "node scripts/fetch-elements.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.nyamath.desktop",
    "productName": "NyaMath",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.mjs",
      "electron/preload.cjs",
      "electron/icons/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "icon": "electron/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "NyaMath",
      "syncDesktopName": true
    },
    "mac": {
      "icon": "electron/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "katex": "^0.18.7",
    "mathjs": "^15.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "three": "^0.186.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
